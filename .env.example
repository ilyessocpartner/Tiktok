# ============================================================
# POLYMARKET TRADING BOT — CONFIGURATION
# Copy this file to .env and fill in your values
# ⚠️  NEVER commit your .env file to git
# ============================================================

# --- Polygon Wallet ---
# Your Metamask/wallet private key (with 0x prefix)
PRIVATE_KEY=0xyour_private_key_here

# --- Polymarket API Credentials ---
# Get these from polymarket.com → Account → API Keys
POLY_API_KEY=your_api_key
POLY_API_SECRET=your_api_secret
POLY_API_PASSPHRASE=your_api_passphrase

# --- Telegram ---
# Get token from @BotFather, chat_id from @userinfobot
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrstUVWxyz
TELEGRAM_CHAT_ID=your_chat_id

# --- Safety ---
# ALWAYS start with DRY_RUN=true to test without real money
DRY_RUN=true

# --- Strategies ---
ENABLE_WEATHER_TRADER=true
ENABLE_FAST_LOOP=false

# --- Weather Trader ---
WEATHER_ENTRY_THRESHOLD=0.08
WEATHER_EXIT_THRESHOLD=0.08
WEATHER_MAX_POSITION=2.0
WEATHER_LOCATIONS=NYC,Chicago,Seattle,Atlanta,Dallas,Miami
WEATHER_SCAN_FREQ=120

# --- Fast Loop (BTC 5/15-min) ---
FAST_LOOP_POSITION_SIZE=5.0
FAST_LOOP_MAX_POSITIONS=3
FAST_LOOP_SCAN_FREQ=5
FAST_LOOP_EXIT_BEFORE_CLOSE=15
FAST_LOOP_ENTRY_DEVIATION=0.005

# --- Risk Management ---
MAX_DAILY_LOSS=50.0
MAX_CONSECUTIVE_LOSSES=3
STOP_LOSS_PER_TRADE=3.0

# --- Logging ---
LOG_LEVEL=INFO
